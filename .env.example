# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== AI Provider (OpenAI-compatible) =====
# Contoh untuk Google Gemini:
# OPENAI_API_KEY=AIzaSy...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
# OPENAI_VISION_MODEL=gemini-2.5-flash
#
# Biarkan kosong jika ingin pakai onboarding screen di aplikasi.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash
OPENAI_VISION_MODEL=gemini-2.5-flash

# Batas penggunaan AI (per IP)
AI_RATE_WINDOW_MIN=15
AI_RATE_MAX_REQ=30

# Ukuran maksimum upload gambar (byte)
MAX_IMAGE_BYTES=5242880
